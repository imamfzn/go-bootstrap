# Copy to .env for local development: cp .env.example .env
# The values below match compose.yaml. Production values come from the
# platform (Cloud Run environment variables and Secret Manager), not a file.

SERVICE_NAME=go-bootstrap
LOG_LEVEL=debug

# --- PostgreSQL -------------------------------------------------------------
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
TEST_DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
DB_MAX_CONNS=5
# On Cloud Run, connect through the Cloud SQL connector with IAM auth:
#   DATABASE_URL=postgres://<service-account-without-.gserviceaccount.com>@localhost/app
#   DB_INSTANCE_CONNECTION_NAME=<project>:<region>:<instance>
#   DB_IAM_AUTH=true

# --- Pub/Sub ----------------------------------------------------------------
PUBSUB_PROJECT_ID=local
PUBSUB_EMULATOR_HOST=localhost:8085
TOPIC_ORDER_CREATED=order-created
SUBSCRIPTION_ORDER_CREATED=order-created-worker

# --- API --------------------------------------------------------------------
PORT=8080
# Local only: trusts the bearer token as the user ID, with no verification.
AUTH_DEV_INSECURE=true

# --- Worker -----------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_HANDLER_TIMEOUT=30s

# --- Orders -----------------------------------------------------------------
ORDER_PENDING_TTL=24h

# --- Payment provider -------------------------------------------------------
# Leave PAYMENT_BASE_URL empty to approve every payment locally.
PAYMENT_BASE_URL=
PAYMENT_API_KEY=
PAYMENT_TIMEOUT=10s
